{% extends 'base.html.twig' %}

{% block title %}Inscription - SchoolPrepar{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">Créer un compte</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form, {''attr'': {''class'': ''form''}}) }}
                        
                        <div class="mb-3">
                            {{ form_label(form.nom, ''Nom'', {''label_attr'': {''class'': ''form-label''}}) }}
                            {{ form_widget(form.nom, {''attr'': {''class'': ''form-control''}}) }}
                            {{ form_errors(form.nom, {''attr'': {''class'': ''invalid-feedback d-block''}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.prenom, ''Prénom'', {''label_attr'': {''class'': ''form-label''}}) }}
                            {{ form_widget(form.prenom, {''attr'': {''class'': ''form-control''}}) }}
                            {{ form_errors(form.prenom, {''attr'': {''class'': ''invalid-feedback d-block''}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.email, ''Email'', {''label_attr'': {''class'': ''form-label''}}) }}
                            {{ form_widget(form.email, {''attr'': {''class'': ''form-control''}}) }}
                            {{ form_errors(form.email, {''attr'': {''class'': ''invalid-feedback d-block''}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.telephone, ''Téléphone'', {''label_attr'': {''class'': ''form-label''}}) }}
                            {{ form_widget(form.telephone, {''attr'': {''class'': ''form-control''}}) }}
                            {{ form_errors(form.telephone, {''attr'': {''class'': ''invalid-feedback d-block''}}) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.mot_de_passe, ''Mot de passe'', {''label_attr'': {''class'': ''form-label''}}) }}
                            {{ form_widget(form.mot_de_passe, {''attr'': {''class'': ''form-control''}}) }}
                            {{ form_errors(form.mot_de_passe, {''attr'': {''class'': ''invalid-feedback d-block''}}) }}
                        </div>

                        <button type="submit" class="btn btn-success w-100">S''inscrire</button>
                    {{ form_end(form) }}

                    <hr>
                    <p class="text-center mb-0">Déjà inscrit? <a href="{{ path(''app_login'') }}" class="text-decoration-none">Se connecter</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
