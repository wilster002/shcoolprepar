{% extends 'front/base.html.twig' %}

{% block title %}Inscription - SchoolPrepare{% endblock %}

{% block page_header %}
<!-- START SECTION TOP -->
<section class="section-top">
    <div class="container">
        <div class="col-lg-10 offset-lg-1 text-center">
            <div class="section-top-title wow fadeInRight" data-wow-duration="1s" data-wow-delay="0.3s" data-wow-offset="0">
                <h1>Créer un Compte</h1>
                <ul>
                    <li><a href="{{ path('home') }}">Accueil</a></li>
                    <li> / Inscription</li>
                </ul>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION TOP -->
{% endblock %}

{% block body %}
<!-- START CONTACT SECTION -->
<div id="contact" class="contact_area section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 offset-lg-2 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.2s" data-wow-offset="0">
                <div class="contact">

                    {{ form_start(form, {'attr': {'class': 'form'}}) }}

                        <div class="row">
                            <div class="form-group col-md-6">
                                {{ form_label(form.nom, 'Nom') }}
                                {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Votre nom de famille'}}) }}
                                {% if form.nom.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        {% for error in form.nom.vars.errors %}{{ error.message }}{% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="form-group col-md-6">
                                {{ form_label(form.prenom, 'Prénom') }}
                                {{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Votre prénom'}}) }}
                                {% if form.prenom.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        {% for error in form.prenom.vars.errors %}{{ error.message }}{% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="form-group col-md-12">
                                {{ form_label(form.email, 'Adresse Email') }}
                                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'exemple@email.com'}}) }}
                                {% if form.email.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        {% for error in form.email.vars.errors %}{{ error.message }}{% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="form-group col-md-12">
                                {{ form_label(form.telephone, 'Téléphone') }}
                                {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': '0600000000'}}) }}
                                {% if form.telephone.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        {% for error in form.telephone.vars.errors %}{{ error.message }}{% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="form-group col-md-12" style="margin-bottom: 15px;">
                                {{ form_label(form.mot_de_passe, 'Mot de passe') }}
                                {{ form_widget(form.mot_de_passe, {'attr': {'class': 'form-control', 'placeholder': 'Entrez un mot de passe sécurisé'}}) }}
                                {% if form.mot_de_passe.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        {% for error in form.mot_de_passe.vars.errors %}{{ error.message }}{% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="col-md-12 text-center">
                                <button type="submit" class="btn_one">S'Inscrire</button>
                            </div>

                            <div class="col-md-12 text-center mt-3">
                                <p>Déjà inscrit? <a href="{{ path('app_login') }}" class="text-decoration-none"><strong>Se connecter</strong></a></p>
                            </div>
                        </div>

                    {{ form_end(form) }}

                </div>
            </div>
        </div>
    </div>
</div>
<!-- END CONTACT SECTION -->
{% endblock %}
