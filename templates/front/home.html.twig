<!-- START POPULAR COURSES (FILIERES) -->
<section class="home_course section-padding">
    <div class="container">
        <div class="section-title text-center">
            <h2>Filières Populaires</h2>
            <p>Explorez nos filières les plus demandées et trouvez celle qui vous correspond.</p>
        </div>
        <div class="row">
            {% if filieres|default([]) is not empty %}
                {% for filiere in filieres|slice(0, 3) %}
                <div class="col-lg-4 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.1s" data-wow-offset="0">
                    <div class="single_course">
                        <div class="course_head" style="position: relative; overflow: hidden;">
                            <img src="{{ asset('eduleb/img/course/1.png') }}" class="img-fluid" alt="{{ filiere.nom }}" />
                            <div style="position: absolute; top: 10px; right: 10px;">
                                {% if filiere.niveau|default(false) %}
                                <span style="background: #525fe1; color: white; padding: 5px 10px; border-radius: 4px; font-size: 12px;">{{ filiere.niveau }}</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="course_content" style="display: flex; flex-direction: column; height: 100%;">
                            <h3><a href="#">{{ filiere.nom }}</a></h3>
                            <p style="color: #999; font-size: 14px; margin-bottom: 8px;">
                                {% if filiere.domaine|default(false) %}
                                <i class="ti-folder" style="color: #525fe1;"></i> {{ filiere.domaine }}
                                {% endif %}
                            </p>
                            <p style="margin-bottom: 15px; flex-grow: 1;">{{ filiere.description|length > 70 ? filiere.description|slice(0, 70) ~ '...' : filiere.description }}</p>
                            <a class="btn_one" href="#" style="margin-top: auto; display: block;">Voir Plus <i class="ti-arrow-top-right"></i></a>
                        </div>
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="col-md-12 text-center">
                    <p class="text-muted">Aucune filière disponible pour l'instant.</p>
                </div>
            {% endif %}
        </div>
        <div class="row mt-4 text-center">
            <div class="col-md-12">
                <a class="btn_one" href="{{ path('user_filieres') }}">Voir Toutes les Filières <i class="ti-arrow-top-right"></i></a>
            </div>
        </div>
    </div>
</section>
<!-- END POPULAR COURSES -->

