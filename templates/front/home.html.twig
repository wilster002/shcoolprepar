<!-- START COUNTER -->
<section class="count_area counter_feature">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-folder sc_one"></span>
                    <h2 class="counter-num" data-target="50">0</h2>
                    <p>Filières</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-medall-alt sc_two"></span>
                    <h2 class="counter-num" data-target="200">0</h2>
                    <p>Établissements</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-id-badge sc_three"></span>
                    <h2 class="counter-num" data-target="100">0</h2>
                    <p>Conseillers</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-user sc_four"></span>
                    <h2 class="counter-num" data-target="1000">0</h2>
                    <p>Étudiants Inscrits</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END COUNTER -->

<script>
// Counter animation
document.addEventListener('DOMContentLoaded', function() {
    const counters = document.querySelectorAll('.counter-num');
    const speed = 50; // milliseconds per increment

    counters.forEach(counter => {
        const target = parseInt(counter.getAttribute('data-target'));
        let current = 0;

        const increment = Math.ceil(target / 100);

        const updateCount = () => {
            if (current < target) {
                current += increment;
                if (current > target) current = target;
                counter.textContent = current + '+';
                setTimeout(updateCount, speed);
            }
        };

        // Start animation when element is in view
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    updateCount();
                    observer.unobserve(entry.target);
                }
            });
        });

        observer.observe(counter);
    });
});
</script>

