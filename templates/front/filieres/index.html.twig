{% extends 'front/base.html.twig' %}

{% block title %}Nos Filières - SchoolPrepare{% endblock %}

{% block page_header %}
<!-- START SECTION TOP -->
<section class="section-top">
    <div class="container">
        <div class="col-lg-10 offset-lg-1 text-center">
            <div class="section-top-title wow fadeInRight" data-wow-duration="1s" data-wow-delay="0.3s" data-wow-offset="0">
                <h1>Nos Filières</h1>
                <ul>
                    <li><a href="{{ path('home') }}">Accueil</a></li>
                    <li> / Filières</li>
                </ul>
            </div>
        </div>
    </div>
</section>
<!-- END SECTION TOP -->
{% endblock %}

{% block body %}
<!-- START COURSES SECTION -->
<section class="home_course section-padding">
    <div class="container">
        <div class="section-title text-center">
            <h2>Explorez Nos Filières</h2>
            <p>Découvrez nos filières d'études et trouvez celle qui correspond à vos aspirations.</p>
        </div>

        {% if filieres|length > 0 %}
        <div class="row">
            {% for filiere in filieres %}
            <div class="col-lg-4 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.1s" data-wow-offset="0">
                <div class="single_course">
                    <div class="course_head" style="position: relative; overflow: hidden;">
                        <img src="{{ asset('eduleb/img/course/1.png') }}" class="img-fluid" alt="{{ filiere.nom }}" />
                        <div style="position: absolute; top: 10px; right: 10px;">
                            {% if filiere.niveau|default(false) %}
                            <span style="background: #525fe1; color: white; padding: 5px 10px; border-radius: 4px; font-size: 12px;">{{ filiere.niveau }}</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="course_content" style="display: flex; flex-direction: column; height: 100%;">
                        <h3><a href="#">{{ filiere.nom }}</a></h3>

                        <p style="color: #999; font-size: 14px; margin-bottom: 8px;">
                            {% if filiere.domaine|default(false) %}
                            <i class="ti-folder" style="color: #525fe1;"></i> {{ filiere.domaine }}
                            {% endif %}
                        </p>

                        <p style="margin-bottom: 12px; flex-grow: 1;">{{ filiere.description|length > 80 ? filiere.description|slice(0, 80) ~ '...' : filiere.description }}</p>

                        <div style="margin-bottom: 15px; min-height: 40px;">
                            <small style="color: #999; display: block; line-height: 1.4;">
                                {% if filiere.debouches|default(false) %}
                                <i class="ti-briefcase"></i> Débouchés: {{ filiere.debouches|length > 40 ? filiere.debouches|slice(0, 40) ~ '...' : filiere.debouches }}
                                {% endif %}
                            </small>
                        </div>

                        <a class="btn_one" href="#" style="margin-top: auto; display: block;">Voir les Détails <i class="ti-arrow-top-right"></i></a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="row">
            <div class="col-md-12 text-center py-5">
                <p class="text-muted fs-5">Aucune filière trouvée pour le moment.</p>
                <p class="text-muted">Veuillez réessayer plus tard.</p>
            </div>
        </div>
        {% endif %}

    </div>
</section>
<!-- END COURSES SECTION -->
{% endblock %}