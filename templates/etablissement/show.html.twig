{% extends 'admin/base.html.twig' %}

{% block title %}Détails de l'Établissement - Admin{% endblock %}

{% block body %}
<div class="page-heading">
    <div class="page-title-headings">
        <h3>Détails de l'Établissement</h3>
        <div>
            <a href="{{ path('app_etablissement_edit', {'id': etablissement.id}) }}" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Modifier
            </a>
            <a href="{{ path('app_etablissement_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
        </div>
    </div>
</div>

<section class="section">
    <div class="card">
        <div class="card-header">
            <h4>{{ etablissement.nom }}</h4>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th style="width: 25%">ID</th>
                        <td>{{ etablissement.id }}</td>
                    </tr>
                    <tr>
                        <th>Nom</th>
                        <td>{{ etablissement.nom }}</td>
                    </tr>
                    <tr>
                        <th>Localisation</th>
                        <td>{{ etablissement.localisation }}</td>
                    </tr>
                    <tr>
                        <th>Contact</th>
                        <td>
                            <a href="tel:{{ etablissement.contact }}">{{ etablissement.contact }}</a>
                        </td>
                    </tr>
                    <tr>
                        <th>Type</th>
                        <td>
                            <span class="badge bg-light-primary">{{ etablissement.type }}</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>
{% endblock %}
