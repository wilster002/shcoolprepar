{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'form'}}) }}

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="form-group">
            {{ form_label(form.nom, 'Nom de l\'établissement') }}
            {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'ex: Lycée Pierre Dupont'}}) }}
            {% if form.nom.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block">
                    {% for error in form.nom.vars.errors %}{{ error.message }}{% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="form-group">
            {{ form_label(form.localisation, 'Localisation') }}
            {{ form_widget(form.localisation, {'attr': {'class': 'form-control', 'placeholder': 'ex: Paris, Île-de-France'}}) }}
            {% if form.localisation.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block">
                    {% for error in form.localisation.vars.errors %}{{ error.message }}{% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="form-group">
            {{ form_label(form.contact, 'Numéro de contact') }}
            {{ form_widget(form.contact, {'attr': {'class': 'form-control', 'placeholder': 'ex: 0123456789'}}) }}
            {% if form.contact.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block">
                    {% for error in form.contact.vars.errors %}{{ error.message }}{% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="form-group">
            {{ form_label(form.type, 'Type d\'établissement') }}
            {{ form_widget(form.type, {'attr': {'class': 'form-control', 'placeholder': 'ex: Lycée, Collège'}}) }}
            {% if form.type.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block">
                    {% for error in form.type.vars.errors %}{{ error.message }}{% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>

<div class="d-flex gap-2 mt-4">
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-save me-1"></i> {{ button_label ?? 'Enregistrer' }}
    </button>
    <a href="{{ path('app_etablissement_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-x-circle me-1"></i> Annuler
    </a>
</div>

{{ form_end(form) }}
