{% extends 'admin/base.html.twig' %}

{% block title %}Modifier un Établissement - Admin{% endblock %}

{% block body %}
<div class="page-heading">
    <h3>Modifier l'Établissement</h3>
</div>

<section class="section">
    <div class="card">
        <div class="card-header">
            <h4>{{ etablissement.nom }}</h4>
        </div>
        <div class="card-body">
            {% include 'etablissement/_form.html.twig' with {'button_label': 'Modifier l\'établissement'} %}
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h4 class="text-danger">Zone de danger</h4>
        </div>
        <div class="card-body">
            <p class="mb-3">Supprimer cet établissement (irréversible)</p>
            {% include 'etablissement/_delete_form.html.twig' %}
        </div>
    </div>
</section>
{% endblock %}
